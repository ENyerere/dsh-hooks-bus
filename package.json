{
  "name": "dsh-hooks-bus",
  "description": "DSH hooks bus: a managed subscription layer over the official lifecycle interception surface (versioned catalog, priorities, timeouts, error isolation, dispatch logs).",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hooks",
    "events",
    "hooks-bus"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "version": "0.2.0",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "client",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "test": "vitest run",
    "check:client": "node --check client/client.js"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "dependencies": {
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^22.20.0",
    "cordis": "^4.0.0-rc.7",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "schemastery": "^3.18.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
